# ===== DailyPaper AI 配置 =====
# Anthropic 官方 API Key，在 https://console.anthropic.com/settings/keys 创建（形如 sk-ant-...）
ANTHROPIC_API_KEY=

# —— 以下为可选项，使用官方 API 时保持留空 ——
# 自定义接口地址（代理或兼容网关）；留空即官方 https://api.anthropic.com
ANTHROPIC_BASE_URL=
# 以 "Authorization: Bearer" 方式发送的令牌（部分网关需要）；与 API_KEY 二选一
ANTHROPIC_AUTH_TOKEN=
